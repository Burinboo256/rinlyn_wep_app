# Auth — ตั้งค่านี้ทุก environment
AUTH_SECRET=change-me-to-a-random-32-char-string

# Database path (ค่าเริ่มต้น: data.db ในโฟลเดอร์โปรเจกต์)
# บน Railway ให้ mount Volume ที่ /data แล้วตั้งเป็น /data/data.db
DB_PATH=./data.db

# Default admin (ใช้แค่ครั้งแรก ถ้า users table ว่าง)
INIT_ADMIN_USERNAME=boss
INIT_ADMIN_PASSWORD=boss123
INIT_ADMIN_NAME=หัวหน้าทีม

# Railway ตั้งค่านี้อัตโนมัติ
# PORT=3001
